{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "cli/**",
    "**/*.toml",
    "**/node_modules/**",
    "**/dist/**",
    "**/*.tsbuildinfo",
    "tests/frontend/snapshots/**",
    "src/frontend/lib/api/generated/**",
    "build/**",
    "tmp/**"
  ]
}
