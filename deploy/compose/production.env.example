# ---------------------------------------------------------------------------
# camply-web Production Docker Compose Configuration
#
# Copy this file to .env beside docker-compose.production.yaml (or pass --env-file):
#   cp deploy/compose/production.env.example .env
#   docker compose -f deploy/compose/docker-compose.production.yaml up -d
# ---------------------------------------------------------------------------

# Published GHCR image tag (v2 tracks latest v2.x release, or pin e.g. v2.1.0)
CAMPLY_VERSION=v2

# Public frontend URL (required; used in summary notification links)
CAMPLY_APP_URL=https://camply.example.com

# Trusted browser origins for CORS and password login (JSON array)
CAMPLY_CORS_ORIGINS='["https://camply.example.com"]'

# Host bind address and port for the Nginx frontend container.
# Keep 127.0.0.1 when terminating TLS with a local reverse proxy (Caddy/Nginx/Traefik).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# PostgreSQL credentials (POSTGRES_PASSWORD is required)
POSTGRES_USER=camply
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=camply

# Authentication: "session" (recommended default) or "auth0"
CAMPLY_AUTH_MODE=session
CAMPLY_ADMIN_EMAIL=admin@example.com
CAMPLY_INVITE_ONLY=false

# Session authentication credentials (required when CAMPLY_AUTH_MODE=session)
# Generate CAMPLY_SESSION_SECRET (>=32 chars) with: openssl rand -hex 32
CAMPLY_LOGIN_USERNAME=admin
CAMPLY_LOGIN_PASSWORD=replace-with-a-strong-login-password
CAMPLY_SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
CAMPLY_SESSION_MAX_AGE=43200
# Keep true behind HTTPS; set false only for private plain-HTTP deployments.
CAMPLY_SESSION_COOKIE_SECURE=true

# Auth0 settings (required only when CAMPLY_AUTH_MODE=auth0)
# CAMPLY_AUTH0_DOMAIN=your-tenant.us.auth0.com
# CAMPLY_AUTH0_AUDIENCE=https://api.camply.example.com
# CAMPLY_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# Notifications
CAMPLY_NOTIFICATION_MODE=summary
# PUSHOVER_APP_TOKEN=
CAMPLY_NTFY_SUBSCRIPTION_URL=https://ntfy.sh
# CAMPLY_NTFY_PUBLISH_URL=

# Worker & API tuning
GUNICORN_WORKERS=2
CAMPLY_HEARTBEAT_INTERVAL=300
CAMPLY_TARGET_COOLDOWN=55
# PROMETHEUS_RETENTION=30d

# Optional Sentry error reporting (forwarded to backend, worker, and beat)
# CAMPLY_SENTRY_DSN=
# CAMPLY_SENTRY_TRACES_SAMPLE_RATE=0.0
