{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "camply-web chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "env": {
      "$ref": "#/definitions/env"
    },
    "envFrom": {
      "$ref": "#/definitions/envFrom"
    },
    "annotations": {
      "$ref": "#/definitions/annotations"
    },
    "podAnnotations": {
      "$ref": "#/definitions/annotations"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "securityContext": {
      "type": "object"
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": ["string", "integer"]
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "waitTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "envFrom": {
          "$ref": "#/definitions/envFrom"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "probes",
        "enabled",
        "replicas",
        "args",
        "env",
        "envFrom",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "service",
        "resources"
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "envFrom": {
          "$ref": "#/definitions/envFrom"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "probes",
        "replicas",
        "args",
        "env",
        "envFrom",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "service",
        "resources"
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "envFrom": {
          "$ref": "#/definitions/envFrom"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "probes",
        "enabled",
        "replicas",
        "args",
        "env",
        "envFrom",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "resources"
      ]
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "enabled": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "envFrom": {
          "$ref": "#/definitions/envFrom"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "probes",
        "enabled",
        "args",
        "env",
        "envFrom",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "resources"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        }
      },
      "required": [
        "enabled",
        "image",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "securityContext",
        "resources",
        "persistence"
      ]
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        }
      },
      "required": [
        "enabled",
        "url",
        "existingSecret",
        "urlKey",
        "image",
        "args",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "resources",
        "persistence"
      ]
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalUrl": {
          "type": "string"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "retention": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        }
      },
      "required": [
        "enabled",
        "externalUrl",
        "image",
        "retention",
        "annotations",
        "podAnnotations",
        "podSecurityContext",
        "resources",
        "persistence"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/definitions/annotations"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "scrapeTimeout": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "definitions": {
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": ["string", "number", "boolean"]
          },
          {
            "type": "object",
            "required": ["valueFrom"],
            "properties": {
              "valueFrom": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "probe": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "httpGet": {
              "type": "object"
            },
            "exec": {
              "type": "object"
            },
            "tcpSocket": {
              "type": "object"
            },
            "grpc": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "not": {
                "required": ["httpGet", "exec"]
              }
            },
            {
              "not": {
                "required": ["httpGet", "tcpSocket"]
              }
            },
            {
              "not": {
                "required": ["httpGet", "grpc"]
              }
            },
            {
              "not": {
                "required": ["exec", "tcpSocket"]
              }
            },
            {
              "not": {
                "required": ["exec", "grpc"]
              }
            },
            {
              "not": {
                "required": ["tcpSocket", "grpc"]
              }
            }
          ]
        }
      ]
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": ["string", "null"]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadOnlyMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "retain": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      },
      "required": [
        "enabled",
        "existingClaim",
        "accessModes",
        "size",
        "retain",
        "annotations"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      },
      "required": ["type", "port", "annotations"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgresql": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "database": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "valkey": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "valkey": {
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "valkey": {
                "properties": {
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "frontend": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "anyOf": [
              {
                "properties": {
                  "route": {
                    "properties": {
                      "parentRefs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "gateway": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "gateway": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "route": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "gateway": {
                "properties": {
                  "className": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "required": [
    "image",
    "imagePullSecrets",
    "env",
    "envFrom",
    "annotations",
    "podAnnotations",
    "nodeSelector",
    "tolerations",
    "affinity",
    "terminationGracePeriodSeconds",
    "securityContext",
    "migrations",
    "frontend",
    "backend",
    "worker",
    "beat",
    "database",
    "postgresql",
    "valkey",
    "prometheus",
    "ingress",
    "route",
    "gateway",
    "extraObjects",
    "serviceMonitor",
    "tests"
  ]
}
