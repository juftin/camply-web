{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Camply CLI YAML configuration",
  "description": "The configuration accepted by camply campsites --yaml-config.",
  "type": "object",
  "additionalProperties": false,
  "required": ["searches"],
  "properties": {
    "defaults": {
      "$ref": "#/$defs/searchDefaults"
    },
    "searches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/search"
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "selectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {
          "$ref": "#/$defs/date",
          "description": "Inclusive check-in date."
        },
        "end_date": {
          "$ref": "#/$defs/date",
          "description": "Exclusive checkout date."
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "date_windows"],
      "anyOf": [
        {
          "required": ["campgrounds"],
          "properties": {
            "campgrounds": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["recreation_areas"],
          "properties": {
            "recreation_areas": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlankString",
          "description": "Unique within the file."
        },
        "provider": {
          "$ref": "#/$defs/nonBlankString",
          "description": "A provider name or alias recognized by camply."
        },
        "campgrounds": {
          "$ref": "#/$defs/selectors"
        },
        "recreation_areas": {
          "$ref": "#/$defs/selectors"
        },
        "campsites": {
          "$ref": "#/$defs/selectors"
        },
        "date_windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dateWindow"
          }
        },
        "days": {
          "$ref": "#/$defs/days"
        },
        "weekends": {
          "$ref": "#/$defs/weekends"
        },
        "nights": {
          "$ref": "#/$defs/nights"
        },
        "campsite_types": {
          "$ref": "#/$defs/campsite_types"
        },
        "electric": {
          "$ref": "#/$defs/electric"
        },
        "accessible": {
          "$ref": "#/$defs/accessible"
        },
        "rv_length": {
          "description": "Minimum compatible RV length. Set to null to clear an inherited length.",
          "anyOf": [{ "$ref": "#/$defs/rv_length" }, { "type": "null" }]
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "notifications": {
          "$ref": "#/$defs/notifications"
        },
        "state_file": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "days": {
      "description": "English weekday names or abbreviations.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\s*([Mm][Oo][Nn]([Dd][Aa][Yy])?|[Tt][Uu][Ee]([Ss]([Dd][Aa][Yy])?)?|[Ww][Ee][Dd]([Nn][Ee][Ss][Dd][Aa][Yy])?|[Tt][Hh][Uu]([Rr]([Ss]([Dd][Aa][Yy])?)?)?|[Ff][Rr][Ii]([Dd][Aa][Yy])?|[Ss][Aa][Tt]([Uu][Rr][Dd][Aa][Yy])?|[Ss][Uu][Nn]([Dd][Aa][Yy])?)\\s*$"
      }
    },
    "weekends": {
      "type": "boolean"
    },
    "nights": {
      "type": "integer",
      "minimum": 1
    },
    "campsite_types": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\s*([Tt][Ee][Nn][Tt]|[Rr][Vv]|[Cc][Aa][Bb][Ii][Nn]|[Oo][Tt][Hh][Ee][Rr])\\s*$",
        "examples": ["TENT", "RV", "CABIN", "OTHER"]
      }
    },
    "electric": {
      "type": "boolean"
    },
    "accessible": {
      "type": "boolean"
    },
    "rv_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "interval": {
      "type": "integer",
      "minimum": 5
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\s*([Pp][Uu][Ss][Hh][Oo][Vv][Ee][Rr]|[Nn][Tt][Ff][Yy])\\s*$",
        "examples": ["pushover", "ntfy"]
      }
    },
    "searchDefaults": {
      "description": "Shared settings inherited by searches that omit the corresponding field.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {
          "$ref": "#/$defs/days"
        },
        "weekends": {
          "$ref": "#/$defs/weekends"
        },
        "nights": {
          "$ref": "#/$defs/nights"
        },
        "campsite_types": {
          "$ref": "#/$defs/campsite_types"
        },
        "electric": {
          "$ref": "#/$defs/electric"
        },
        "accessible": {
          "$ref": "#/$defs/accessible"
        },
        "rv_length": {
          "$ref": "#/$defs/rv_length"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "notifications": {
          "$ref": "#/$defs/notifications"
        }
      }
    }
  }
}
