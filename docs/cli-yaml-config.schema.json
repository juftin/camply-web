{
  "$defs": {
    "DateWindow": {
      "additionalProperties": false,
      "description": "A check-in and checkout pair in the config file.",
      "properties": {
        "days": {
          "description": "English weekday names or abbreviations. An explicit empty list clears inherited weekdays.",
          "items": {
            "pattern": "^\\s*(?:[mM][oO][nN][dD][aA][yY]|[mM][oO][nN]|[tT][uU][eE][sS][dD][aA][yY]|[tT][uU][eE]|[tT][uU][eE][sS]|[wW][eE][dD][nN][eE][sS][dD][aA][yY]|[wW][eE][dD]|[tT][hH][uU][rR][sS][dD][aA][yY]|[tT][hH][uU]|[tT][hH][uU][rR]|[tT][hH][uU][rR][sS]|[fF][rR][iI][dD][aA][yY]|[fF][rR][iI]|[sS][aA][tT][uU][rR][dD][aA][yY]|[sS][aA][tT]|[sS][uU][nN][dD][aA][yY]|[sS][uU][nN])\\s*$",
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "weekends": {
          "default": false,
          "description": "Include Friday and Saturday nights. An explicit false clears an inherited weekend filter.",
          "title": "Weekends",
          "type": "boolean"
        },
        "start_date": {
          "description": "Inclusive check-in date.",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "description": "Exclusive checkout date.",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "End Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "SearchDefaults": {
      "additionalProperties": false,
      "description": "Settings that may be shared by all searches.",
      "properties": {
        "days": {
          "description": "English weekday names or abbreviations. An explicit empty list clears inherited weekdays.",
          "items": {
            "pattern": "^\\s*(?:[mM][oO][nN][dD][aA][yY]|[mM][oO][nN]|[tT][uU][eE][sS][dD][aA][yY]|[tT][uU][eE]|[tT][uU][eE][sS]|[wW][eE][dD][nN][eE][sS][dD][aA][yY]|[wW][eE][dD]|[tT][hH][uU][rR][sS][dD][aA][yY]|[tT][hH][uU]|[tT][hH][uU][rR]|[tT][hH][uU][rR][sS]|[fF][rR][iI][dD][aA][yY]|[fF][rR][iI]|[sS][aA][tT][uU][rR][dD][aA][yY]|[sS][aA][tT]|[sS][uU][nN][dD][aA][yY]|[sS][uU][nN])\\s*$",
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "weekends": {
          "default": false,
          "description": "Include Friday and Saturday nights. An explicit false clears an inherited weekend filter.",
          "title": "Weekends",
          "type": "boolean"
        },
        "nights": {
          "default": 1,
          "minimum": 1,
          "title": "Nights",
          "type": "integer"
        },
        "campsite_types": {
          "items": {
            "examples": [
              "TENT",
              "RV",
              "CABIN",
              "OTHER"
            ],
            "pattern": "^\\s*(?:[tT][eE][nN][tT]|[rR][vV]|[cC][aA][bB][iI][nN]|[oO][tT][hH][eE][rR])\\s*$",
            "type": "string"
          },
          "title": "Campsite Types",
          "type": "array"
        },
        "electric": {
          "default": false,
          "title": "Electric",
          "type": "boolean"
        },
        "accessible": {
          "default": false,
          "title": "Accessible",
          "type": "boolean"
        },
        "rv_length": {
          "maximum": 200,
          "minimum": 1,
          "title": "Rv Length",
          "type": "integer"
        },
        "interval": {
          "default": 10,
          "minimum": 5,
          "title": "Interval",
          "type": "integer"
        },
        "stop_on_match": {
          "default": false,
          "title": "Stop On Match",
          "type": "boolean"
        },
        "notifications": {
          "items": {
            "examples": [
              "pushover",
              "ntfy",
              "webhook",
              "discord",
              "slack",
              "telegram"
            ],
            "pattern": "^\\s*(?:[pP][uU][sS][hH][oO][vV][eE][rR]|[nN][tT][fF][yY]|[wW][eE][bB][hH][oO][oO][kK]|[dD][iI][sS][cC][oO][rR][dD]|[sS][lL][aA][cC][kK]|[tT][eE][lL][eE][gG][rR][aA][mM])\\s*$",
            "type": "string"
          },
          "title": "Notifications",
          "type": "array"
        },
        "max_notifications": {
          "default": 5,
          "description": "Maximum notifications per channel per check cycle before collapsing overflow into a summary.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Notifications",
          "type": "integer"
        }
      },
      "title": "SearchDefaults",
      "type": "object"
    },
    "SearchInput": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "campgrounds": {
              "minItems": 1
            }
          },
          "required": [
            "campgrounds"
          ]
        },
        {
          "properties": {
            "recreation_areas": {
              "minItems": 1
            }
          },
          "required": [
            "recreation_areas"
          ]
        }
      ],
      "description": "A single named search and its optional overrides.",
      "properties": {
        "days": {
          "description": "English weekday names or abbreviations. An explicit empty list clears inherited weekdays.",
          "items": {
            "pattern": "^\\s*(?:[mM][oO][nN][dD][aA][yY]|[mM][oO][nN]|[tT][uU][eE][sS][dD][aA][yY]|[tT][uU][eE]|[tT][uU][eE][sS]|[wW][eE][dD][nN][eE][sS][dD][aA][yY]|[wW][eE][dD]|[tT][hH][uU][rR][sS][dD][aA][yY]|[tT][hH][uU]|[tT][hH][uU][rR]|[tT][hH][uU][rR][sS]|[fF][rR][iI][dD][aA][yY]|[fF][rR][iI]|[sS][aA][tT][uU][rR][dD][aA][yY]|[sS][aA][tT]|[sS][uU][nN][dD][aA][yY]|[sS][uU][nN])\\s*$",
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "weekends": {
          "default": false,
          "description": "Include Friday and Saturday nights. An explicit false clears an inherited weekend filter.",
          "title": "Weekends",
          "type": "boolean"
        },
        "nights": {
          "default": 1,
          "minimum": 1,
          "title": "Nights",
          "type": "integer"
        },
        "campsite_types": {
          "items": {
            "examples": [
              "TENT",
              "RV",
              "CABIN",
              "OTHER"
            ],
            "pattern": "^\\s*(?:[tT][eE][nN][tT]|[rR][vV]|[cC][aA][bB][iI][nN]|[oO][tT][hH][eE][rR])\\s*$",
            "type": "string"
          },
          "title": "Campsite Types",
          "type": "array"
        },
        "electric": {
          "default": false,
          "title": "Electric",
          "type": "boolean"
        },
        "accessible": {
          "default": false,
          "title": "Accessible",
          "type": "boolean"
        },
        "rv_length": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum compatible RV length. Set to null to clear an inherited length.",
          "title": "Rv Length"
        },
        "interval": {
          "default": 10,
          "minimum": 5,
          "title": "Interval",
          "type": "integer"
        },
        "stop_on_match": {
          "default": false,
          "title": "Stop On Match",
          "type": "boolean"
        },
        "notifications": {
          "items": {
            "examples": [
              "pushover",
              "ntfy",
              "webhook",
              "discord",
              "slack",
              "telegram"
            ],
            "pattern": "^\\s*(?:[pP][uU][sS][hH][oO][vV][eE][rR]|[nN][tT][fF][yY]|[wW][eE][bB][hH][oO][oO][kK]|[dD][iI][sS][cC][oO][rR][dD]|[sS][lL][aA][cC][kK]|[tT][eE][lL][eE][gG][rR][aA][mM])\\s*$",
            "type": "string"
          },
          "title": "Notifications",
          "type": "array"
        },
        "max_notifications": {
          "default": 5,
          "description": "Maximum notifications per channel per check cycle before collapsing overflow into a summary.",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Notifications",
          "type": "integer"
        },
        "name": {
          "description": "Unique within the file.",
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "description": "A provider name or alias recognized by camply.",
          "pattern": "\\S",
          "title": "Provider",
          "type": "string"
        },
        "campgrounds": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Campgrounds",
          "type": "array"
        },
        "recreation_areas": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Recreation Areas",
          "type": "array"
        },
        "campsites": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Campsites",
          "type": "array"
        },
        "dates": {
          "items": {
            "$ref": "#/$defs/DateWindow"
          },
          "minItems": 1,
          "title": "Dates",
          "type": "array"
        },
        "state_file": {
          "pattern": "\\S",
          "title": "State File",
          "type": "string"
        }
      },
      "required": [
        "name",
        "provider",
        "dates"
      ],
      "title": "SearchInput",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The configuration accepted by camply campsites --yaml-config.",
  "properties": {
    "version": {
      "const": 2,
      "description": "CLI YAML configuration format version.",
      "maximum": 2,
      "minimum": 2,
      "title": "Version",
      "type": "integer"
    },
    "defaults": {
      "$ref": "#/$defs/SearchDefaults"
    },
    "searches": {
      "items": {
        "$ref": "#/$defs/SearchInput"
      },
      "minItems": 1,
      "title": "Searches",
      "type": "array"
    }
  },
  "required": [
    "version",
    "searches"
  ],
  "title": "Camply CLI YAML configuration",
  "type": "object"
}
