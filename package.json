{
  "name": "camply-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node node_modules/@typescript/native/bin/tsc --project tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc --project tsconfig.node.json --noEmit && node node_modules/@typescript/native/bin/tsc --project tsconfig.snapshots.json --noEmit && node node_modules/@typescript/native/bin/tsc --project tsconfig.functions.json --noEmit && vite build --config vite.config.ts",
    "lint": "oxlint src/frontend vite.config.ts --report-unused-disable-directives --max-warnings 0 && oxfmt --check .",
    "fix": "oxlint src/frontend vite.config.ts --fix && oxfmt .",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --project tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc --project tsconfig.node.json --noEmit && node node_modules/@typescript/native/bin/tsc --project tsconfig.snapshots.json --noEmit && node node_modules/@typescript/native/bin/tsc --project tsconfig.functions.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "codegen": "tsx src/frontend/tooling/codegen.ts",
    "snapshot": "tsx src/frontend/tooling/run-snapshots.ts",
    "snapshot:update": "tsx src/frontend/tooling/run-snapshots.ts --update",
    "snapshot:check": "tsx src/frontend/tooling/run-snapshots.ts --check",
    "format": "cd ${INIT_CWD} && oxfmt"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.29.0",
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.105.0",
    "@types/dompurify": "^3.2.0",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.14.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
