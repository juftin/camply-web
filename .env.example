# ---------------------------------------------------------------------------
# camply Local Development Environment Configuration
# Copy this file to .env: cp .env.example .env
# ---------------------------------------------------------------------------

# Authentication
# Modes: "none" (automatic login), "session" (password login), "auth0"
CAMPLY_AUTH_MODE=none
# Docker Compose supplies local-only session defaults when these are unset.
# CAMPLY_LOGIN_USERNAME=admin
# CAMPLY_LOGIN_PASSWORD=camply
# CAMPLY_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# CAMPLY_SESSION_COOKIE_SECURE=false

# Database
# Default: SQLite (local file at ~/.local/share/camply/camply.db)
# CAMPLY_DB_DRIVERNAME=sqlite+aiosqlite
#
# When running PostgreSQL via Docker Compose (`task compose:infra`):
# CAMPLY_DB_DRIVERNAME=postgresql+psycopg
# CAMPLY_DB_HOST=localhost
# CAMPLY_DB_PORT=5432
# CAMPLY_DB_USERNAME=camply
# CAMPLY_DB_PASSWORD=camply
# CAMPLY_DB_DATABASE=camply

# Valkey / Redis broker for Celery
CAMPLY_VALKEY_URL=redis://localhost:6379/0

# Frontend API URL target for Vite proxy
CAMPLY_API_URL=http://localhost:8000

# Optional: Extra CORS origins (comma-separated or JSON list)
# CAMPLY_CORS_ORIGINS='["http://localhost:5173"]'

# Optional: Notifications
# PUSHOVER_APP_TOKEN=

# Docker Compose overrides
FRONTEND_PORT=80
