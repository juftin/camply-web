{
  "name": "camply-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run typecheck && vite build --config vite.config.ts",
    "lint": "oxlint src functions --report-unused-disable-directives --max-warnings 0 && oxfmt --check .",
    "fix": "oxlint src functions --fix && oxfmt .",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --project tsconfig.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "codegen": "tsx src/lib/codegen.ts",
    "snapshot": "tsx scripts/run-snapshots.ts",
    "snapshot:update": "tsx scripts/run-snapshots.ts --update",
    "snapshot:check": "tsx scripts/run-snapshots.ts --check",
    "format": "cd ${INIT_CWD} && oxfmt"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.17.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.84.2",
    "@types/dompurify": "^3.0.5",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "google-map-react": "^2.2.5",
    "lucide-react": "^0.536.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.7.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.34.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/google-map-react": "^2.1.10",
    "@types/node": "^24.19.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6"
}
